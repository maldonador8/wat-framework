# Copy to .env and fill in only the keys for the tools you use.

# Anthropic (content_pipeline, ad_copy_generator, cold_outreach, bible_video_*)
ANTHROPIC_API_KEY=

# Stripe (stripe_mrr)
STRIPE_SECRET_KEY=

# Buffer (buffer_post)
BUFFER_ACCESS_TOKEN=

# X / Twitter (twitter_auth, twitter_post)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Sender details used in outreach drafts (cold_outreach)
INVOICE_NAME=
INVOICE_TITLE=
INVOICE_COMPANY=
SMTP_EMAIL=
